# === Pixelitl Display — sdkconfig defaults ===

# CPU: Max frequency, dual-core
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# PSRAM (8MB on this board)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Flash (8MB, QIO for max bandwidth)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# LCD RGB Panel
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# Memory
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Compiler optimization: Performance over size
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Task watchdog (generous for WASM interpreter)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi defaults
CONFIG_PIXELITL_WIFI_SSID="The Nest"
CONFIG_PIXELITL_WIFI_PASSWORD="Palabanda!"

# WiFi memory: minimize internal SRAM usage (PSRAM handles dynamic buffers)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# TLS: use PSRAM for mbedtls buffers (internal SRAM too tight)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_HARDWARE_AES=n
